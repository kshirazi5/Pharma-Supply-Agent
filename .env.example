# ─── Google Gemini / ADK ───────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here

# ─── Slack Integration ────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
SLACK_TEAM_ID=T0000000000
SLACK_CHANNEL=#supply-chain

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
SECRET_KEY=change_this_to_a_random_256bit_secret
ADMIN_PASSWORD=choose_an_admin_password
MANAGER_PASSWORD=choose_a_manager_password

# ─── Procurement Settings ─────────────────────────────────────────────────────
PROCUREMENT_BUDGET=50000
APPROVAL_THRESHOLD=10000

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key_here

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGIN=http://localhost:3000
